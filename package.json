{
  "name": "english-intensive-listening-player",
  "version": "1.0.0",
  "description": "English Intensive Listening Player desktop application",
  "author": "English Learning App",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite & electron electron/main.cjs --dev",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.english.intensive.listening",
    "productName": "English Intensive Listening",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.22.3",
    "lucide-react": "0.294.0",
    "clsx": "2.1.1",
    "react-player": "2.16.0",
    "@vitejs/plugin-react": "^5.1.2",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
